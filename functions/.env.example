# Server-side MSG91 AuthKey only. Never use VITE_MSG91_AUTHKEY.
# Copy to functions/.env for local emulator use. Do not commit real values.
MSG91_AUTHKEY=

# Comma-separated browser origins allowed to call this function.
# Local emulator defaults to Vite origins if this is unset.
# Production MUST set this. Do not put secrets here.
# Example: https://fishmart.prnexusgroup.com
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173
