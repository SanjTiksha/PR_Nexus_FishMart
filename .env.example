# Optional production branding (Vite exposes only VITE_* vars)
VITE_APP_TITLE=PR Nexus FishMart
VITE_APP_DESCRIPTION=Fresh Fish Every Morning
VITE_APP_URL=https://your-domain.com

# UPI merchant config (public UPI ID — not a secret API key)
# Overrides Firestore/local shopInfo.upiId when set
# Personal (P2P) UPI ID — do not use paytmqr / @ptys merchant VPAs here
VITE_PAYMENT_UPI_ID=pavansmurkute@okicici
VITE_PAYMENT_MERCHANT_NAME=PR Nexus FishMart

# MSG91 OTP Widget (checkout mobile verification only — client tokenAuth, NOT AuthKey)
# Widget: SecureOTPWidgetMQDP
VITE_MSG91_WIDGET_ID=3668696a785a393837353034
# Put your MSG91 OTP Widget client token here locally in .env (never commit real token)
VITE_MSG91_OTP_TOKEN=YOUR_MSG91_CLIENT_TOKEN
