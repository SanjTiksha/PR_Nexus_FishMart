rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * Phase A admin Auth: Email/Password for management accounts only.
     * No custom claims / Cloud Functions required.
     */
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email is string
        && request.auth.token.email in [
          'support@prnexusgroup.com',
          'info@prnexusgroup.com'
        ];
    }

    function isCustomerUid(uid) {
      return uid.matches('^phone_91[6-9][0-9]{9}$');
    }

    function isCustomerAuth() {
      return request.auth != null && isCustomerUid(request.auth.uid);
    }

    // ---------- Catalog / storefront (public read) ----------

    match /fishes/{docId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /reviews/{docId} {
      allow read: if true;
      // Public may CREATE one review document only
      allow create: if true;
      // Public must NOT update or delete reviews
      allow update, delete: if isAdmin();
    }

    match /offers/{docId} {
      allow read: if true;
      // No public usedCount (or any) updates — checkout treats increment as best-effort
      allow create, update, delete: if isAdmin();
    }

    match /shopSetting/{docId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /promotionAndDiscounts/{docId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /config/{docId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // ---------- Admin-only operations ----------

    match /daily/{docId} {
      allow read, create, update, delete: if isAdmin();
    }

    match /rateHistory/{docId} {
      allow read, create, update, delete: if isAdmin();
    }

    match /AdminLogs/{docId} {
      allow read, create, update, delete: if isAdmin();
    }

    // Diagnostics probe — admin only (public load tolerates failure)
    match /_test_connection/{docId} {
      allow read, create, update, delete: if isAdmin();
    }

    // ---------- Customer orders ----------
    // Unauthenticated customers may CREATE a new order document only.
    // Customers may READ only documents they own (customerUid == request.auth.uid).
    // No public update / delete (prevents payment tampering).

    match /orders/{orderId} {
      allow create: if
        request.resource.data.orderId == orderId
        && request.resource.data.paymentStatus == 'PENDING_CONFIRMATION'
        && request.resource.data.paidVerified == false
        && (
          (
            !isCustomerAuth()
            && !('customerUid' in request.resource.data)
          )
          || (
            isCustomerAuth()
            && request.resource.data.customerUid == request.auth.uid
          )
        );

      allow read: if isAdmin()
        || (
          isCustomerAuth()
          && 'customerUid' in resource.data
          && resource.data.customerUid == request.auth.uid
        );

      allow update, delete: if isAdmin();
    }

    // ---------- Customer profiles (Phase 1A.7) ----------
    // Identity document only. Does not grant order access.

    function isValidCustomerProfileCreate(uid) {
      let d = request.resource.data;
      return request.auth != null
        && request.auth.uid == uid
        && isCustomerUid(uid)
        && d.keys().hasOnly(['uid', 'mobile10', 'createdAt', 'updatedAt', 'schemaVersion'])
        && d.uid == uid
        && d.mobile10 is string
        && d.mobile10.matches('^[6-9][0-9]{9}$')
        && uid == ('phone_91' + d.mobile10)
        && d.schemaVersion == 1
        && d.createdAt is timestamp
        && d.updatedAt is timestamp;
    }

    match /customers/{uid} {
      allow read: if isAdmin()
        || (request.auth != null && request.auth.uid == uid);

      allow create: if isValidCustomerProfileCreate(uid);

      allow update: if false;

      allow delete: if isAdmin();
    }

    // ---------- Default deny ----------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
