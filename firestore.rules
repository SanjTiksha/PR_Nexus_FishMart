rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * Phase A admin Auth: Email/Password for management accounts only.
     * No custom claims / Cloud Functions required.
     */
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email is string
        && request.auth.token.email in [
          'support@prnexusgroup.com',
          'info@prnexusgroup.com'
        ];
    }

    function isCustomerUid(uid) {
      return uid.matches('^phone_91[6-9][0-9]{9}$');
    }

    function isCustomerAuth() {
      return request.auth != null && isCustomerUid(request.auth.uid);
    }

    // ---------- Catalog / storefront (public read) ----------

    match /fishes/{docId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /reviews/{docId} {
      allow read: if true;
      // Public may CREATE one review document only
      allow create: if true;
      // Public must NOT update or delete reviews
      allow update, delete: if isAdmin();
    }

    match /offers/{docId} {
      allow read: if true;
      // No public usedCount (or any) updates — checkout treats increment as best-effort
      allow create, update, delete: if isAdmin();
    }

    match /shopSetting/{docId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /promotionAndDiscounts/{docId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /config/{docId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // ---------- Admin-only operations ----------

    match /daily/{docId} {
      allow read, create, update, delete: if isAdmin();
    }

    match /rateHistory/{docId} {
      allow read, create, update, delete: if isAdmin();
    }

    match /AdminLogs/{docId} {
      allow read, create, update, delete: if isAdmin();
    }

    // Diagnostics probe — admin only (public load tolerates failure)
    match /_test_connection/{docId} {
      allow read, create, update, delete: if isAdmin();
    }

    // ---------- Customer orders ----------
    // Unauthenticated customers may CREATE a new order document only.
    // Customers may READ only documents they own (customerUid == request.auth.uid).
    // No public update / delete (prevents payment tampering).

    match /orders/{orderId} {
      allow create: if
        request.resource.data.orderId == orderId
        && request.resource.data.paymentStatus == 'PENDING_CONFIRMATION'
        && request.resource.data.paidVerified == false
        && (
          (
            !isCustomerAuth()
            && !('customerUid' in request.resource.data)
          )
          || (
            isCustomerAuth()
            && request.resource.data.customerUid == request.auth.uid
          )
        );

      allow read: if isAdmin()
        || (
          isCustomerAuth()
          && 'customerUid' in resource.data
          && resource.data.customerUid == request.auth.uid
        );

      allow update, delete: if isAdmin();
    }

    // ---------- Customer profiles (Phase 1A.7) ----------
    // Identity document only. Does not grant order access.

    function isValidCustomerProfileCreate(uid) {
      let d = request.resource.data;
      return request.auth != null
        && request.auth.uid == uid
        && isCustomerUid(uid)
        && d.keys().hasOnly(['uid', 'mobile10', 'createdAt', 'updatedAt', 'schemaVersion'])
        && d.uid == uid
        && d.mobile10 is string
        && d.mobile10.matches('^[6-9][0-9]{9}$')
        && uid == ('phone_91' + d.mobile10)
        && d.schemaVersion == 1
        && d.createdAt is timestamp
        && d.updatedAt is timestamp;
    }

    function isValidCustomerProfileUpdate(uid) {
      let before = resource.data;
      let after = request.resource.data;
      return request.auth != null
        && request.auth.uid == uid
        && isCustomerUid(uid)
        && after.uid == before.uid
        && after.mobile10 == before.mobile10
        && after.createdAt == before.createdAt
        && after.schemaVersion == before.schemaVersion
        && after.keys().hasOnly([
          'uid',
          'mobile10',
          'createdAt',
          'updatedAt',
          'schemaVersion',
          'displayName',
          'defaultAddressId'
        ])
        && after.diff(before).affectedKeys()
          .hasOnly(['displayName', 'defaultAddressId', 'updatedAt'])
        && after.updatedAt is timestamp
        && (!('displayName' in after)
          || (after.displayName is string
            && after.displayName.size() > 0
            && after.displayName.size() <= 80))
        && (!('defaultAddressId' in after)
          || (after.defaultAddressId is string
            && after.defaultAddressId.size() > 0
            && after.defaultAddressId.size() <= 128));
    }

    function isValidCustomerAddressWrite(uid, addressId, isCreate) {
      let d = request.resource.data;
      return request.auth != null
        && request.auth.uid == uid
        && isCustomerUid(uid)
        && d.addressId == addressId
        && d.keys().hasOnly([
          'addressId',
          'label',
          'fullName',
          'mobile10',
          'address',
          'landmark',
          'location',
          'createdAt',
          'updatedAt'
        ])
        && d.label in ['Home', 'Office', 'Other']
        && d.fullName is string
        && d.fullName.size() > 0
        && d.fullName.size() <= 80
        && d.mobile10 is string
        && d.mobile10.matches('^[6-9][0-9]{9}$')
        && d.address is string
        && d.address.size() > 0
        && d.address.size() <= 500
        && (!('landmark' in d)
          || (d.landmark is string && d.landmark.size() > 0 && d.landmark.size() <= 120))
        && d.location.keys().hasOnly(['lat', 'lng', 'confirmed'])
        && d.location.lat is number
        && d.location.lng is number
        && d.location.lat >= -90
        && d.location.lat <= 90
        && d.location.lng >= -180
        && d.location.lng <= 180
        && d.location.confirmed == true
        && d.createdAt is timestamp
        && d.updatedAt is timestamp
        && (
          isCreate
          || d.createdAt == resource.data.createdAt
        );
    }

    match /customers/{uid} {
      allow read: if isAdmin()
        || (request.auth != null && request.auth.uid == uid);

      allow create: if isValidCustomerProfileCreate(uid);

      allow update: if isValidCustomerProfileUpdate(uid);

      allow delete: if isAdmin();

      match /addresses/{addressId} {
        allow read: if isAdmin()
          || (request.auth != null && request.auth.uid == uid);

        allow create: if isValidCustomerAddressWrite(uid, addressId, true);

        allow update: if isValidCustomerAddressWrite(uid, addressId, false);

        allow delete: if isAdmin()
          || (request.auth != null && request.auth.uid == uid);
      }
    }

    // ---------- Default deny ----------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
